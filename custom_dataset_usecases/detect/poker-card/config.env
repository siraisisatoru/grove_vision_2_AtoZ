# poker-card — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=augmented-startups
ROBOFLOW_PROJECT=playing-cards-ow27d
ROBOFLOW_VERSION=4
ROBOFLOW_FORMAT=yolo26

# Training
MODEL=yolo26n.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=10C,10D,10H,10S,...
SCORE_THRESHOLD=30
ALGO=3

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
