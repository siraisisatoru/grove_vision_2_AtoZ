# Deer detector (YOLO26, 320) — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=yolo-giypc
ROBOFLOW_PROJECT=deer-ntgfk-ft5ko
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolo26

# Training
MODEL=yolo26n.pt
EPOCHS=150
IMGSZ=320
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=Deer
SCORE_THRESHOLD=30

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
