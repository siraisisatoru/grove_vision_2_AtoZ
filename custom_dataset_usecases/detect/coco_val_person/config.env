# coco_val_person — person detector fine-tuned from yolo26n.pt on COCO val2017
#
# Dataset is DERIVED, not fetched. Build it first (idempotent, downloads ~865 MB
# of raw COCO into datasets/_coco_raw/ on the first run only):
#   python3 custom_dataset_usecases/coco_val_person/build_dataset.py
# then always run with --skip-fetch (there is no Roboflow project):
#   ./flow.sh --coco_val_person --yolo26 --skip-fetch
#
# 2423 train / 270 valid images, 10777 person boxes — about 56x the data of
# coco128_person, which was data-limited (its val losses were still falling at
# the last epoch). See readme.md.

# Roboflow coordinates — unused (--skip-fetch), present so flow.sh's env
# sourcing stays happy.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
ROBOFLOW_FORMAT=yolo26

MODEL=yolo26n.pt

# 2423 images at batch 16 is 152 optimizer steps per epoch, ~70 s/epoch on MPS,
# so this is roughly a 70-minute run. Fine-tuning from COCO-pretrained weights on
# a COCO subset converges well before this; check runs/train/results.csv and stop
# early if val mAP50 plateaus.
EPOCHS=60
BATCH=16

# MUST match the convert step and be a multiple of 32 (Yolo26::isValid() rejects
# otherwise). Training AT the deploy resolution is the whole point: the model
# never sees detail it will not have at inference.
IMGSZ=288

# FREEZE deliberately unset (unlike coco128_person, which froze the backbone at
# 10). Freezing is a small-data defence — with 2423 images a full fine-tune adapts
# the backbone to 288-scale features and beats a frozen one.
# FREEZE=10

SCORE_THRESHOLD=40

SMOKE=0
