# Cheese detector (YOLO26) — non-secret configuration (safe to commit)
#
# Source: https://universe.roboflow.com/julius-muller/cheese-9udht

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=julius-muller
ROBOFLOW_PROJECT=cheese-9udht
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolo26

# Training
MODEL=yolo26n.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=Cheese
SCORE_THRESHOLD=20

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
