# mixed_sheep_yolo26 — sheep detector (YOLO26) — non-secret configuration (safe to commit)
#
# Roboflow equivalent of:
#   project = rf.workspace("ali-eren-altindag").project("mixed_sheep")
#   version = project.version(1)
#   dataset = version.download("yolo26")
#
# Second sheep use case alongside sheep_yolo26 (riis/aerial-sheep), which is
# aerial/top-down. This one is a different capture style, so the two are worth
# comparing rather than merging — the settings below deliberately match
# sheep_yolo26 so the comparison is apples-to-apples.
#
# Note: the use-case directory name (and therefore datasets/<name>/) is
# mixed_sheep_yolo26, matching the deer_yolo26 / sheep_yolo26 convention. Only
# ROBOFLOW_PROJECT below has to match Roboflow's actual project slug, mixed_sheep.
#
# Run:
#   ./flow.sh --mixed_sheep_yolo26 --yolo26

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=ali-eren-altindag
ROBOFLOW_PROJECT=mixed_sheep
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolo26

# Training
# Fetched 2026-08-07: nc=1 (sheep), 1797 train / 599 valid images, 6675 train
# boxes, 161 MB. test/ ships empty from Roboflow, which is fine — training only
# reads train/ and valid/, and valid/ doubles as the INT8 calibration set.
# 1797 images at batch 16 is 113 optimizer steps per epoch.
MODEL=yolo26n.pt
EPOCHS=150
BATCH=16

# Matches sheep_yolo26 so the two sheep models are directly comparable. Must be a
# multiple of 32 and must match the convert step.
#
# ⚠ MEASURED (2026-08-07, 6675 train boxes) — 192 is probably too small here:
#
#     median box 0.93% of frame     p25 0.23%     p75 4.15%
#     boxes >= 1% of frame : 3150 (47%)
#     boxes >= 3% of frame : 1898 (28%)
#
# 1% of frame is ~19 px at IMGSZ=192, so the MEDIAN sheep is about 19 px and 53%
# of boxes fall below that. This is the coco_val_person failure mode — see that
# use case's readme: 45% of its boxes were unresolvable at 288 and capped mAP50
# at ~0.53 no matter how much data was added. Here the fraction is worse (53%)
# and the input is smaller.
#
# IMGSZ=288 puts 1% of frame at ~29 px and still fits WE2 comfortably (709 KiB of
# the 1100 KiB arena, 0 CPU-fallback ops, ~11.4 FPS). Left at 192 only to keep
# the sheep_yolo26 comparison honest — if the goal is the best mixed_sheep model
# rather than the comparison, set 288 here before the first run.
IMGSZ=288

# Stream view
# LABELS — auto-detected from data.yaml after fetch; confirmed to resolve to
# "sheep" (nc=1). Uncomment only to override.
# LABELS=sheep
# Starting point only — sheep_yolo26 needed 60 for aerial shots. Tune against the
# live stream once the class names and detection quality are known.
SCORE_THRESHOLD=40

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
