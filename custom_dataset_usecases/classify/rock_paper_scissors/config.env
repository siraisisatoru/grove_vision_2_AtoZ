# rock_paper_scissors — 3-class hand-gesture classifier, verification use case
# for the classify pipeline (see custom_dataset_usecases/classify/template_classify/).
#
# Dataset: "Rock-Paper-Scissors" by Seeed Studio on Roboflow Universe —
# https://universe.roboflow.com/seeed-studio-ovcjn/rock-paper-scissors-7zj4d/dataset/1
# 2520 images, 3 balanced classes (~840 each), 70/20/10 train/valid/test split.
# Published by Seeed (the board vendor) as the reference dataset for their own
# Grove Vision AI V2 classification tutorial. Already a Classification-type
# project — ROBOFLOW_FORMAT=folder below downloads it directly as
# train/<class>/*.jpg, no conversion needed.
#
# Expected to train to high accuracy: rock (closed fist) / paper (flat open
# palm) / scissors (two-finger V) are about the most grossly distinct hand
# silhouettes possible — an easier version of the same "gross silhouette, not
# finger detail" selection criterion custom_dataset_usecases/detect/hagrid_gestures/
# used to pick its own safest gesture classes, and classification has no
# localization step to get wrong on top of that.
#
# Not yet verified end-to-end against the live Roboflow project (workspace/
# project/version were read off the Universe URL, not fetched directly —
# universe.roboflow.com returned 403 to a direct page fetch). Double-check
# these three values against the page before running for real.

# Task is determined by living under custom_dataset_usecases/classify/ (and
# selected on the CLI via --classify/<name>) — no TASK= line needed here.

ROBOFLOW_WORKSPACE=seeed-studio-ovcjn
ROBOFLOW_PROJECT=rock-paper-scissors-7zj4d
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=folder

# yolo11n-cls.pt is plenty for 3 grossly-distinct classes at this resolution.
# Also verified against custom_cnn/tiny_dscnn/ (MODEL=tiny_dscnn) — a
# hand-rolled architecture, no Ultralytics — on this same dataset; see its
# README for measured results. Output is namespaced by MODEL, so switching
# between the two here never overwrites the other's runs/convert output.
MODEL=yolo11n-cls.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# LABELS — auto-detected from the sorted train/<class>/ subdirs after fetch;
# uncomment to override
# LABELS=Paper,Rock,Scissors
SCORE_THRESHOLD=30

# Set SMOKE=1 for a quick offline sanity-check (generates a synthetic
# ImageFolder dataset, no API key needed) before spending a real download on it.
SMOKE=0
