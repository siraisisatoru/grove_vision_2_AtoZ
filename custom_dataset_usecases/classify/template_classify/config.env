# <use-case> — non-secret configuration (safe to commit)
#
# Classification use case. Unlike the detection template/, this expects (and
# for Roboflow, downloads) an ImageFolder-layout dataset:
#   train/<class_name>/*.jpg
#   valid/<class_name>/*.jpg   (or val/ / validation/ — Ultralytics accepts any)
#   test/<class_name>/*.jpg
# No bbox labels, no data.yaml — class names come from the sorted subdirectory
# names under train/ (see helper_scripts/get_labels.py --classify).

# Task is determined by living under custom_dataset_usecases/classify/ (and
# selected on the CLI via --classify/<name>) — no TASK= line needed here.

# Roboflow project coordinates. Must be a Classification project (Multiclass) —
# ROBOFLOW_FORMAT=folder below downloads it directly in the ImageFolder shape.
ROBOFLOW_WORKSPACE=your-workspace
ROBOFLOW_PROJECT=your-project-name
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=folder

# Training. yolo11n-cls.pt / yolo26n-cls.pt are the classification-task
# checkpoints — plain yolo11n.pt/yolo26n.pt are detection checkpoints and will
# not load as a classifier.
MODEL=yolo11n-cls.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from the sorted train/<class>/ subdirs after fetch;
# uncomment to override
# LABELS=ClassName1,ClassName2
SCORE_THRESHOLD=30

# Set SMOKE=1 for a quick offline sanity-check (generates a synthetic
# ImageFolder dataset, no API key needed)
SMOKE=0
