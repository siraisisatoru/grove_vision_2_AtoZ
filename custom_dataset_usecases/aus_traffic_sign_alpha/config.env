# <use-case> — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=elec5308-w8jl5
ROBOFLOW_PROJECT=australia-traffic-sign-alpha
ROBOFLOW_VERSION=11

# Training
MODEL=yolo11n.pt
EPOCHS=120
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=ClassName1,ClassName2
SCORE_THRESHOLD=25

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
