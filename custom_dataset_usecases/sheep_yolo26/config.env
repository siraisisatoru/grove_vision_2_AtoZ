# aerial-sheep — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=riis
ROBOFLOW_PROJECT=aerial-sheep
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolo26

# Training
MODEL=yolo26n.pt
EPOCHS=150
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=ClassName1,ClassName2
SCORE_THRESHOLD=60

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
