# bike detector — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=project-tdxxb
ROBOFLOW_PROJECT=cctv_car_bike_detection-fhqk8
ROBOFLOW_VERSION=6

# Training
MODEL=yolo11n.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# Stream view
# LABELS — auto-detected from data.yaml after fetch; uncomment to override
# LABELS=Deer
SCORE_THRESHOLD=30

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
