# hagrid_gestures — 5-class hand-gesture detector fine-tuned from yolo26n.pt on HaGRID
#
# Classes (index order, fixed by GESTURES in build_dataset.py):
#   0 palm   1 fist   2 peace   3 like   4 call
#
# Dataset is DERIVED, not fetched from Roboflow. Build it first:
#   custom_dataset_usecases/hagrid_gestures/get_dataset.sh
#   python3 custom_dataset_usecases/hagrid_gestures/build_dataset.py
# then always run with --skip-fetch (there is no Roboflow project):
#   ./flow.sh --hagrid_gestures --yolo26 --skip-fetch
#
# See readme.md for why these five gestures and how the splits are made.

# Roboflow coordinates — unused (--skip-fetch), present so flow.sh's env
# sourcing stays happy.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
ROBOFLOW_FORMAT=yolo26

MODEL=yolo26n.pt

# MEASURED after the real build (2026-08-07): 6179 train / 653 valid images.
# MAX_PER_CLASS=2000 never bites — the 30k subsample only carries ~1768 images
# per class before the no_gesture filter, so the cap is a ceiling we never reach.
#
# 6179 images at batch 16 is 387 optimizer steps per epoch. Scaling from
# coco_val_person's measured 152 steps in 30.2 s on MPS at this resolution,
# expect ~77 s/epoch, so this is roughly a 50-minute run — cheaper than planned.
#
# If you want to spend the freed budget: EPOCHS=60 costs ~75 min and matches
# coco_val_person's schedule. Left at 40 as the first data point. Watch
# runs/train/results.csv and stop early if val mAP50 plateaus.
EPOCHS=120
BATCH=16

# MUST match the convert step and be a multiple of 32 (Yolo26::isValid() rejects
# otherwise). 288 is the measured sweet spot on WE2: 709 KiB of the 1100 KiB
# arena, 0 ops falling back to CPU, ~11.4 FPS. 320 still fits (~890 KiB, ~7.7
# FPS); 352 does not.
IMGSZ=288

# FREEZE deliberately unset. Freezing the backbone is a small-data defence; with
# 10k images a full fine-tune adapts the backbone to 288-scale hand features and
# beats a frozen one. train_model.py omits the kwarg entirely when this is unset.
# FREEZE=10

# LABELS is auto-derived from data.yaml by flow.sh, in class-index order — do not
# set it here, and never reorder GESTURES in build_dataset.py after training, or
# the on-device label mapping silently shifts.

# Five classes competing for the same hand, so per-class confidence sits lower
# than a single-class model's. Start here and tune against the live stream.
SCORE_THRESHOLD=40

SMOKE=0
