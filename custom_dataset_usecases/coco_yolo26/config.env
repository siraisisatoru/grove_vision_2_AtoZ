# coco_yolo26 — stock Ultralytics yolo26n.pt (COCO 80 classes), NO training.
#
# This use case is a feasibility experiment, not a trained model: it takes the
# pretrained yolo26n.pt straight from Ultralytics and pushes it through the
# normal convert → flash → stream path. Always run it with
#
#   ./flow.sh --coco_yolo26 --yolo26 --skip-fetch --skip-train
#
# --skip-fetch  : there is no Roboflow project; datasets/coco_yolo26/ was
#                 populated by hand from the Ultralytics coco128 release asset
#                 (128 images, all 80 classes) and is used ONLY as INT8
#                 calibration data, never for training.
# --skip-train  : datasets/coco_yolo26/runs/train/weights/best.pt is a copy of
#                 helper_scripts/yolo26n.pt. Nothing was fine-tuned. Training
#                 would overwrite it with a 128-image COCO run, which is worse
#                 than the stock weights.
#
# Expect poor accuracy. yolo26n.pt was trained at 640 and is deployed here at
# 288, so small and medium COCO objects will be missed; only large, close,
# high-contrast objects (person, chair, laptop, dog) should register. Fixing
# that means fine-tuning at the deploy size, not changing anything here.

# Roboflow project coordinates — unused (--skip-fetch), present so flow.sh's
# env sourcing and fetch_dataset.py stay happy if invoked by accident.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
ROBOFLOW_FORMAT=yolo26

# Training — MODEL selects the YOLO26 convert pipeline (reg_max==1, 6 raw
# heads, LiteRT). EPOCHS/BATCH are inert under --skip-train.
MODEL=yolo26n.pt
EPOCHS=0
BATCH=16

# IMGSZ must be a multiple of 32 and >= 32: Yolo26::isValid() rejects anything
# else (ma_model_yolo26.cpp, `h % 32 != 0` check), and the three detection
# grids are w>>3, w>>4, w>>5 = 36, 18, 9 here.
#
# 288 was picked as the largest size near 300 that leaves clear headroom in the
# 1100 KB static tensor arena (MA_ENGINE_TFLITE_TENSOE_ARENA_SIZE in
# ma_config_board.h). Peak co-resident feature maps scale with IMGSZ^2:
#
#   IMGSZ   input     stem out   est. Vela SRAM   est. inference
#   192     108 KB    144 KB     322 KB (measured)  46 ms
#   288     243 KB    324 KB     ~730 KB            ~105 ms
#   320     300 KB    400 KB     ~890 KB            ~129 ms
#   384     432 KB    576 KB     ~1280 KB  OVER     --
#
# Check yolo26_int8_summary_My_Sys_Cfg.csv's sram_memory_used after converting.
# Vela is given a 4 MB arena budget by himax_vela.ini and does NOT enforce the
# real 1100 KB, so an over-budget model compiles cleanly and then corrupts the
# camera framebuffer or the FreeRTOS heap on device.
IMGSZ=288

# Stream view — LABELS is auto-detected from datasets/coco_yolo26/data.yaml
# (the 80 COCO names, in class-index order).
# Threshold is low because 640-trained weights running at 288 produce weak
# confidences; raise it once you see what actually gets detected.
SCORE_THRESHOLD=25

SMOKE=0
