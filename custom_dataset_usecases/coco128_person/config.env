# coco128_person — single-class person detector, fine-tuned from yolo26n.pt
#
# Dataset is DERIVED, not fetched. Build it first (idempotent):
#   python3 custom_dataset_usecases/coco128_person/build_dataset.py
# then always run with --skip-fetch (there is no Roboflow project):
#   ./flow.sh --coco128_person --yolo26 --skip-fetch
#
# 48 train / 13 valid images, 254 person boxes. That is TINY — this exists to
# test whether fine-tuning at the deploy resolution fixes what coco_yolo26
# showed (stock 640-trained weights are unusable on a pixelated 288 frame), not
# to be a production person detector. See readme.md for the larger COCO person
# subset if you want real accuracy.

# Roboflow coordinates — unused (--skip-fetch), present so flow.sh's env
# sourcing stays happy.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
ROBOFLOW_FORMAT=yolo26

MODEL=yolo26n.pt

# 48 training images overfits fast. 150 epochs with Ultralytics' default
# augmentation (mosaic/HSV/flip) is enough to converge; watch val mAP50 in
# datasets/coco128_person/runs/train/results.csv and cut this back if val loss
# turns up while train loss keeps falling.
EPOCHS=150

# Batch 16 over 48 images is 3 optimizer steps per epoch. Do not raise it.
BATCH=16

# MUST match the convert step and stay a multiple of 32 (Yolo26::isValid()
# rejects otherwise). 288 is the point of this experiment: train at the
# resolution the board actually runs, so the model never sees detail it will
# not have at inference. Peak arena at 288 measured 709 KiB of 1100 KiB on the
# 80-class model; one class is smaller still.
IMGSZ=288

# Freeze the first N modules (backbone) during fine-tuning. On 48 images a full
# unfrozen fine-tune mostly memorises; freezing the COCO-pretrained backbone and
# training only neck+head keeps the general features. Optional knob read by
# train_model.py — unset means normal full fine-tuning.
FREEZE=10

# Single class, so a higher bar than coco_yolo26's 25 is reasonable.
SCORE_THRESHOLD=40

SMOKE=0
