# <use-case> — non-secret configuration (safe to commit)

# Roboflow project coordinates
ROBOFLOW_WORKSPACE=roboflow-universe-projects
ROBOFLOW_PROJECT=hard-hats-fhbh5
ROBOFLOW_VERSION=5

# Training
MODEL=yolo11n.pt
EPOCHS=100
IMGSZ=192
BATCH=16

# Stream view
# LABELS=head,helmet,person
SCORE_THRESHOLD=30

# Set SMOKE=1 for a quick offline sanity-check (generates synthetic data, no API key needed)
SMOKE=0
