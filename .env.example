# Shared secrets — copy this to .env at the repo root and fill in your values.
# flow.sh sources this before any use case's own .env, so ONE key here covers
# every use case: a Roboflow API key authenticates your account, not the
# individual project, so the same key works across all of them.
#
# A use case only needs its own custom_dataset_usecases/<task>/<name>/.env if
# it genuinely needs a different key (e.g. testing against a second Roboflow
# account) — that file, if present, overrides this shared one for that use
# case only.
ROBOFLOW_API_KEY=your_api_key_here
